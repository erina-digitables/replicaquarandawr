# Copy to .env.local (or .env.production.local on your server) and fill in. Never commit either.
# Values go after the = with no quotes.
# Pick one database: your own Postgres (DATABASE_URL) or Supabase. Leave both empty
# to run on the file-based dev backend.

# Public URL of the app (used in email links). http://localhost:3000 in development.
SITE_URL=

# Your own Postgres (replica/vultr.md). The app connects as dawr_app, which row level
# security applies to: postgres://dawr_app:PASSWORD@127.0.0.1:5432/dawr
DATABASE_URL=
# Only for `npm run db:migrate`: the role that owns the tables.
# postgres://dawr_owner:PASSWORD@127.0.0.1:5432/dawr
MIGRATE_DATABASE_URL=

# Supabase project: Settings > API. Server-only: none of these are exposed to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses row level security. Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Resend. On your own Postgres the app sends through Resend's API with this key
# ("Sending access" only). On Supabase it's the SMTP password, set by `supabase config push`.
RESEND_API_KEY=
# A sender on a domain you have verified in Resend, e.g. Dawr <hello@yourdomain.com>
EMAIL_FROM=

# The nightly job (Vercel Cron, or deploy/purge-demo.sh) sends this as a bearer token
# to /api/cron/purge-demo. Any long random string: openssl rand -base64 32
CRON_SECRET=

# Only for `npm run db:seed`: password for the two seeded sample accounts.
SEED_PASSWORD=

# Set to 1 only to run a production build on the file backend locally (never on a server).
DAWR_ALLOW_FAKE_BACKEND=
